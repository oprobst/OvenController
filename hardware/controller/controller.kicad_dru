(version 1)

# Design rules for controller REV A (T019). Values: specs/002-controller-pcb/research.md R2, R13.
# Net classes (controller.kicad_pro): Mains = L_IN, N_IN, L_FUSED; Power; Default.

# Reinforced insulation primary (230 V) <-> everything else, IEC 60664-1 / 62368-1,
# overvoltage category II, pollution degree 2: about 5 mm creepage / 3 mm clearance required,
# 6 mm chosen with margin. The milled slot under the IRM-10-5 adds creepage distance.
(rule "mains_to_low_voltage"
	(condition "A.NetClass == 'Mains' && B.NetClass != 'Mains'")
	(constraint clearance (min 6mm))
	(constraint creepage (min 6mm))
)

# L <-> N behind the fuse: functional insulation.
(rule "mains_l_to_n"
	(condition "A.NetClass == 'Mains' && B.NetClass == 'Mains' && A.Net != B.Net")
	(constraint clearance (min 3mm))
	(constraint creepage (min 3mm))
)

# No vias in mains nets: all mains copper stays on the outer layers, visible and inspectable.
(rule "mains_no_vias"
	(condition "A.Type == 'Via' && A.NetClass == 'Mains'")
	(constraint disallow via)
)

# The board is mounted on a grounded (PE) metal plate: keep mains copper away from the board
# edge and from the mounting holes (basic insulation to PE, with margin).
(rule "mains_to_edge"
	(condition "A.NetClass == 'Mains'")
	(constraint edge_clearance (min 3mm))
)

# physical_hole_clearance: hole_clearance is not checked for NPTH holes without copper (tested
# with KiCad 10.0.3), physical_hole_clearance is.
(rule "mains_to_mounting_holes"
	(condition "A.NetClass == 'Mains' && B.Type == 'Pad' && B.Pad_Type == 'NPTH, mechanical'")
	(constraint physical_hole_clearance (min 3mm))
)

# Mains cover (FR-039, research R19): the polyamide screws of the cover (holes of COV1) keep
# 6 mm to mains copper. Placed after mains_to_mounting_holes so it wins for these holes.
(rule "cover_holes_to_mains"
	(condition "A.Parent == 'COV1' && B.NetClass == 'Mains'")
	(constraint physical_hole_clearance (min 6mm))
)

# Footprint-given exceptions, limited to one part each:
# GCT USB4085 has 0.85 mm pin pitch, so pad-to-pad clearance is 0.15 mm (manufacturable).
(rule "usb_c_fine_pitch"
	(condition "A.Parent == 'J7' && B.Parent == 'J7'")
	(constraint clearance (min 0.15mm))
)

# ESP32-S3-WROOM-1U footprint: thermal vias in the ground pad with 0.2 mm drill.
# Check with the board manufacturer (0.2 mm drill may cost extra).
(rule "esp32_thermal_vias"
	(condition "A.Parent == 'U9'")
	(constraint hole_size (min 0.2mm))
)
